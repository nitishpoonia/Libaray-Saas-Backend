# Copy to .env for local development. On Render, set these in the service's Environment tab.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/library_saas

# At least 32 random characters. Generate one with: openssl rand -base64 48
JWT_SECRET=

# Number of proxies in front of the app. Use 1 on Render, 0 locally.
TRUST_PROXY=0

# Local only: add this many milliseconds to every request. Must be 0 in production.
SIMULATE_LATENCY_MS=0

# Firebase service account JSON on one line. Leave empty to disable push notifications.
FIREBASE_SERVICE_ACCOUNT=
