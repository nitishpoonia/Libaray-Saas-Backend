# Copy to .env for local development. On Render, set these in the service's Environment tab.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/library_saas

# At least 32 random characters. Generate one with: openssl rand -base64 48
JWT_SECRET=

# Number of proxies in front of the app. Use 1 on Render, 0 locally.
TRUST_PROXY=0

# Local only: add this many milliseconds to every request. Must be 0 in production.
SIMULATE_LATENCY_MS=0

# Access token lifetime (minutes) and refresh token lifetime (days).
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Free trial for new owner accounts.
TRIAL_DAYS=14

# Student notices: SMS or WHATSAPP. TEXT_PROVIDER=none logs them instead of sending.
STUDENT_NOTICE_CHANNEL=SMS
TEXT_PROVIDER=none

# Razorpay keys (Dashboard > Account & Settings > API Keys). Use test keys locally.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret from Dashboard > Webhooks (events: order.paid)
RAZORPAY_WEBHOOK_SECRET=
# Prices in paise: 99900 = Rs 999 per month for the first branch, 49900 per extra branch.
PLAN_BASE_MONTHLY_PAISE=99900
PLAN_EXTRA_BRANCH_MONTHLY_PAISE=49900

# Firebase service account JSON on one line. Leave empty to disable push notifications.
FIREBASE_SERVICE_ACCOUNT=
